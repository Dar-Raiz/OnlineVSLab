        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="errormsg = &quot;&quot;;&amp;#10;var fbkimagefile;&amp;#10;fbkimagefile = &quot;&quot;;&amp;#10;if (r2reversed === true) {&amp;#10;    correctkey = key_list[(2 - correctword_list[(WordIndex - 1)])];&amp;#10;} else {&amp;#10;    correctkey = key_list[(correctword_list[(WordIndex - 1)] - 1)];&amp;#10;}&amp;#10;if ((Study2Response.keys === correctkey)) {&amp;#10;    r2responseiscorrect = true;&amp;#10;    r2chosenword = correctword_list[(WordIndex - 1)];&amp;#10;    respbox_color = &quot;green&quot;;&amp;#10;    fbkimagefile = &quot;checkmark.png&quot;;&amp;#10;} else {&amp;#10;    if (Study2Response.keys) {&amp;#10;        r2responseiscorrect = false;&amp;#10;        r2chosenword = (3 - correctword_list[(WordIndex - 1)]);&amp;#10;        fbkimagefile = &quot;X_mark.png&quot;;&amp;#10;        respbox_color = &quot;red&quot;;&amp;#10;    } else {&amp;#10;        r2responseiscorrect = false;&amp;#10;        r2chosenword = &quot;miss&quot;;&amp;#10;        fbkimagefile = &quot;poundkey.png&quot;;&amp;#10;        respbox_color = background_color;&amp;#10;        respbox_y = targetword_offset;&amp;#10;        errormsg = &quot;no response&quot;;&amp;#10;    }&amp;#10;}&amp;#10;if ((Study2Response.keys === key_list[0])) {&amp;#10;    respbox_y = topword_offset;&amp;#10;} else {&amp;#10;    if ((Study2Response.keys === key_list[1])) {&amp;#10;        respbox_y = bottomword_offset;&amp;#10;    }&amp;#10;}&amp;#10;if (Study2Response.keys) {&amp;#10;    selectboxtrial_color = selectbox_color;&amp;#10;    confrating_dur = maxconffbkchoice_dur;&amp;#10;    choosefbk_dur = maxconffbkchoice_dur;&amp;#10;    slowresptrial_delay = slowrespmessage_delay;&amp;#10;    slowresptrial_dur = slowrespmessage_dur;&amp;#10;} else {&amp;#10;    selectboxtrial_color = background_color;&amp;#10;    confrating_dur = 0;&amp;#10;    choosefbk_dur = 0;&amp;#10;    slowresptrial_delay = 0;&amp;#10;    slowresptrial_dur = 0;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;r2reversed&quot;, r2reversed);&amp;#10;psychoJS.experiment.addData(&quot;r2responseiscorrect&quot;, r2responseiscorrect);&amp;#10;psychoJS.experiment.addData(&quot;r2chosenword&quot;, r2chosenword);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="errormsg=''&amp;#10;fbkimagefile&amp;#10;fbkimagefile = ''&amp;#10;if r2reversed == True:&amp;#10;    correctkey = key_list[2-correctword_list[WordIndex-1]]&amp;#10;else:&amp;#10;    correctkey = key_list[correctword_list[WordIndex-1]-1]&amp;#10;&amp;#10;if Study2Response.keys == correctkey: &amp;#10;    r2responseiscorrect = True&amp;#10;    r2chosenword = correctword_list[WordIndex-1]&amp;#10;    respbox_color = 'green'&amp;#10;    fbkimagefile = 'checkmark.png'&amp;#10;elif Study2Response.keys:&amp;#10;    r2responseiscorrect = False&amp;#10;    r2chosenword = 3 - correctword_list[WordIndex-1]&amp;#10;    fbkimagefile = 'X_mark.png'&amp;#10;    respbox_color = 'red'&amp;#10;else:&amp;#10;    #no response&amp;#10;    r2responseiscorrect = False&amp;#10;    r2chosenword = 'miss'&amp;#10;    fbkimagefile = 'poundkey.png'&amp;#10;    respbox_color = background_color&amp;#10;    respbox_y = 1&amp;#10;    errormsg = 'no response'&amp;#10;&amp;#10;if Study2Response.keys == key_list[0]: #top word selected&amp;#10;    respbox_y = .1&amp;#10;elif Study2Response.keys == key_list[1]: #bottom word selected&amp;#10;    respbox_y = -0.05&amp;#10;if Study2Response.keys:&amp;#10;    selectboxtrial_color = selectbox_color&amp;#10;    confrating_dur = maxconffbkchoice_dur&amp;#10;    choosefbk_dur = maxconffbkchoice_dur&amp;#10;    slowresptrial_delay = slowrespmessage_delay&amp;#10;    slowresptrial_dur = slowrespmessage_dur&amp;#10;else:&amp;#10;    selectboxtrial_color = background_color&amp;#10;    confrating_dur = 0&amp;#10;    choosefbk_dur = 0&amp;#10;    slowresptrial_delay = 0&amp;#10;    slowresptrial_dur = 0&amp;#10;print(respbox_y)&amp;#10;thisExp.addData('r2reversed',r2reversed)&amp;#10;thisExp.addData('r2responseiscorrect', r2responseiscorrect)&amp;#10;thisExp.addData('r2chosenword', r2chosenword)&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="True" valType="bool" updates="None" name="disabled"/>
        <Param val="SetFbk2" valType="code" updates="None" name="name"/>
