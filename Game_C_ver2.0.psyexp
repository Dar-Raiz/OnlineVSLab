        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="That was the end of the first part.&amp;#10;&amp;#10;In Part #2, you will see the same sets of words that you learned&amp;#10;in Part #1.&amp;#10;&amp;#10;First, select the correct word that is paired with the top word &amp;#10;(based on feedback you got in Part #1)&amp;#10;&amp;#10;Next, you will be asked how confident you are that your answer is&amp;#10;correct. Press a number key '1' through '6' to indicate your &amp;#10;confidence.&amp;#10;1 = ~50% confidence (LOW: ~50/50 guess)&amp;#10;2 = ~60% confidence&amp;#10;3 = ~70% confidence&amp;#10;4 = ~80% confidence&amp;#10;5 = ~90% confidence&amp;#10;6 = ~100% confidence (HIGH: basically 100% sure)" valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="$instruct_width" valType="code" updates="constant" name="wrapWidth"/>
      </TextComponent>
