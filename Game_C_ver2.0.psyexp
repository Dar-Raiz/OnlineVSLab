      <CodeComponent name="JSONLY_TEST" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="var idy;&amp;#10;idy = 0;&amp;#10;console.log(idy)" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
